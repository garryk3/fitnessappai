{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "instructions": [".agents/rules/FLUTTER.md"],
    "mcp": {
        "git": {
            "command": "uvx",
            "args": ["mcp-server-git"],
            "type": "local",
            "enabled": true
        },
        "dart-mcp-server": {
            "type": "local",
            "command": [
                "dart",
                "mcp-server"
            ],
            "enabled": true,
            "environment": {}
            },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        }
    }
}